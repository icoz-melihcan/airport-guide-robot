<?xml version="1.0"?>
<!--
  Havalimani Rehber Robotu (airport_guide) - ana model
  Eksenler: x ileri, y sol, z yukari.
  base_link = govde kutusunun merkezi (yerden 0.12 m yukarida).
  Surus: diferansiyel (2 tahrikli teker onde, 1 sarhos teker/caster arkada).
  Sensorler ayri dosyalarda: sensors/lidar.xacro, sensors/camera.xacro, sensors/bumper.xacro
-->
<robot name="airport_guide" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== OLCULER (metre / kg) ===================== -->
  <xacro:property name="govde_x" value="0.50"/>
  <xacro:property name="govde_y" value="0.40"/>
  <xacro:property name="govde_z" value="0.16"/>
  <xacro:property name="govde_kutle" value="8.0"/>

  <xacro:property name="teker_r" value="0.08"/>
  <xacro:property name="teker_w" value="0.04"/>
  <xacro:property name="teker_kutle" value="0.5"/>
  <xacro:property name="teker_x" value="0.08"/>
  <xacro:property name="teker_y" value="0.23"/>
  <xacro:property name="teker_z" value="-0.04"/>

  <xacro:property name="caster_r" value="0.04"/>
  <xacro:property name="caster_x" value="-0.18"/>

  <xacro:property name="direk_x" value="-0.10"/>
  <xacro:property name="direk_boy" value="1.00"/>

  <!-- ===================== RENKLER ===================== -->
  <material name="beyaz"><color rgba="0.95 0.95 0.95 1"/></material>
  <material name="kirmizi"><color rgba="0.80 0.05 0.05 1"/></material>
  <material name="siyah"><color rgba="0.10 0.10 0.10 1"/></material>
  <material name="gri"><color rgba="0.35 0.35 0.35 1"/></material>

  <!-- ===================== ATALET MAKROLARI ===================== -->
  <xacro:macro name="kutu_atalet" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="silindir_atalet" params="m r h">
    <inertial>
      <origin rpy="${pi/2} 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="kure_atalet" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0"
               iyy="${2*m*r*r/5}" iyz="0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== GOVDE ===================== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${govde_x} ${govde_y} ${govde_z}"/></geometry>
      <material name="beyaz"/>
    </visual>
    <!-- Govdenin ust kenarinda kirmizi serit (sadece gorunus) -->
    <visual>
      <origin xyz="0 0 ${govde_z/2 - 0.02}"/>
      <geometry><box size="${govde_x + 0.006} ${govde_y + 0.006} 0.03"/></geometry>
      <material name="kirmizi"/>
    </visual>
    <collision>
      <geometry><box size="${govde_x} ${govde_y} ${govde_z}"/></geometry>
    </collision>
    <xacro:kutu_atalet m="${govde_kutle}" x="${govde_x}" y="${govde_y}" z="${govde_z}"/>
  </link>

  <!-- ===================== TAHRIK TEKERLERI ===================== -->
  <xacro:macro name="teker" params="ad y_isaret">
    <link name="${ad}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${teker_r}" length="${teker_w}"/></geometry>
        <material name="siyah"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${teker_r}" length="${teker_w}"/></geometry>
      </collision>
      <xacro:silindir_atalet m="${teker_kutle}" r="${teker_r}" h="${teker_w}"/>
    </link>
    <joint name="${ad}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${ad}_wheel_link"/>
      <origin xyz="${teker_x} ${y_isaret*teker_y} ${teker_z}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:teker ad="left" y_isaret="1"/>
  <xacro:teker ad="right" y_isaret="-1"/>

  <!-- ===================== SARHOS TEKER (CASTER) ===================== -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_r}"/></geometry>
      <material name="gri"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_r}"/></geometry>
    </collision>
    <xacro:kure_atalet m="0.2" r="${caster_r}"/>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${-govde_z/2}"/>
  </joint>
  <!-- Caster ayri link olarak kalsin ki surtunme ayari kesin olarak ona uygulansin -->
  <gazebo reference="caster_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- ===================== DIREK + EKRAN (rehber robot gorunumu) ===================== -->
  <link name="direk_link">
    <visual>
      <geometry><box size="0.06 0.06 ${direk_boy}"/></geometry>
      <material name="gri"/>
    </visual>
    <collision>
      <geometry><box size="0.06 0.06 ${direk_boy}"/></geometry>
    </collision>
    <xacro:kutu_atalet m="1.0" x="0.06" y="0.06" z="${direk_boy}"/>
  </link>
  <joint name="direk_joint" type="fixed">
    <parent link="base_link"/>
    <child link="direk_link"/>
    <origin xyz="${direk_x} 0 ${govde_z/2 + direk_boy/2}"/>
  </joint>

  <link name="ekran_link">
    <visual>
      <geometry><box size="0.03 0.32 0.22"/></geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.32 0.22"/></geometry>
    </collision>
    <xacro:kutu_atalet m="0.5" x="0.03" y="0.32" z="0.22"/>
  </link>
  <joint name="ekran_joint" type="fixed">
    <parent link="direk_link"/>
    <child link="ekran_link"/>
    <origin xyz="0.045 0 0.30"/>
  </joint>

  <!-- ===================== SENSORLER (ayri dosyalar) ===================== -->
  <xacro:include filename="sensors/lidar.xacro"/>
  <xacro:include filename="sensors/camera.xacro"/>
  <xacro:include filename="sensors/bumper.xacro"/>

  <!-- ===================== GAZEBO PLUGIN'LERI ===================== -->
  <gazebo>
    <!-- Diferansiyel surus: /cmd_vel dinler, /odom ve /tf yayinlar -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*teker_y}</wheel_separation>
      <wheel_radius>${teker_r}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <!-- Teker eklem acilarini yayinlar -> robot_state_publisher teker TF'lerini uretir -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>