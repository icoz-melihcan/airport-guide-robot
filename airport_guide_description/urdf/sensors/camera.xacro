<?xml version="1.0"?>
<!-- Kamera (Sorumlu: B) - link + joint + Gazebo camera sensoru
     Diregin ust kisminda, yerden ~1.17 m (tabelalari gorecek yukseklik), ileri bakiyor.
     Gazebo topic: /camera/image_raw  ->  ROS: /camera/image_raw (sensor_msgs/msg/Image) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.08 0.05"/></geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.08 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00007" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00007"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="direk_link"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0 0.47"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>camera/image_raw</topic>
      <frame_id>camera_link</frame_id>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3963</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>